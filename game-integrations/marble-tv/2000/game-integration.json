{
  "markets": [],
  "mergeEvent": {
    "_id": null,
    "__v": null,
    "streamServer": "https://d10r8t0fxmjzn1.cloudfront.net",
    "videoExtension": "m3u8",
    "voiceConfig": "https://d10r8t0fxmjzn1.cloudfront.net/youtube/config_voice.json"
  },
  "mergeEventDetails": [],
  "patches": [
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'inGameEventInfo': $exists($v.goalInfo) and $trim($v.goalInfo) != \"\" ? streamServer & '/' & theme & '/event_' & $v.goalInfo & '.json' : \"\" }])})"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'playlist': $exists($v.playlist) and $trim($v.playlist) != \"\" ? streamServer & '/' & theme & '/' & $v.playlist & '.' & videoExtension : \"\" }])})"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'goalInfo': $exists($v.goalInfo) and $trim($v.goalInfo) != \"\" ? streamServer & '/' & theme & '/' & $v.goalInfo & '.json' : \"\" }])})"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v, $i) { $merge([$v, {'phase': $i }])})"
    },
    {
      "op": "remove",
      "path": "/streamServer"
    },
    {
      "op": "remove",
      "path": "/theme"
    },
    {
      "op": "remove",
      "path": "/videoExtension"
    },
    {
      "op": "remove",
      "path": "/eventDetails/0/markets"
    },
    {
      "op": "remove",
      "path": "/eventDetails/1/markets"
    },
    {
      "op": "remove",
      "path": "/gameId"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails/0/result",
      "expression": "$exists(eventDetails[0].result) and $exists(eventDetails[0].result.finalScore) ? eventDetails[0].result.finalScore : \"\""
    },
    {
      "op": "jsonata",
      "path": "/eventDetails/1/result",
      "expression": "$exists(eventDetails[1].result) and $exists(eventDetails[1].result.finalScore) ? eventDetails[1].result.finalScore : \"\""
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($detail) { $sift($detail, function($v, $k) { $k != 'selections' })})"
    }
  ]
}
