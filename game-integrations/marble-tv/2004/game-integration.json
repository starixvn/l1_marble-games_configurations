{
  "markets": [],
  "mergeEvent": {
    "_id": null,
    "__v": null,
    "streamServer": "https://d10r8t0fxmjzn1.cloudfront.net",
    "config": {
      "delay": {
        "eventDetailChangeMs": 6000
      }
    }
  },
  "mergeEventDetails": [],
  "patches": [
    {
      "op": "jsonata",
      "path": "/config/voice/configJson",
      "expression": "streamServer & '/' & theme & '/config_voice.json'"
    },
    {
      "op": "jsonata",
      "path": "/config/intro/prebet",
      "expression": "streamServer & '/' & theme & '/prebet.m3u8'"
    },
    {
      "op": "jsonata",
      "path": "/config/intro/halftime",
      "expression": "streamServer & '/' & theme & '/halftime.m3u8'"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'inGameEventInfo': $exists($v.goalInfo) and $trim($v.goalInfo) != \"\" ? streamServer & '/' & theme & '/event_' & $v.goalInfo & '.json' : \"\" }])})"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'playlist': $exists($v.playlist) and $trim($v.playlist) != \"\" ? streamServer & '/' & theme & '/' & $v.playlist & '.m3u8' : \"\" }])})"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "$map(eventDetails, function($v) { $merge([$v, {'goalInfo': $exists($v.goalInfo) and $trim($v.goalInfo) != \"\" ? streamServer & '/' & theme & '/' & $v.goalInfo & '.json' : \"\" }])})"
    },
    {
      "op": "remove",
      "path": "/streamServer"
    },
    {
      "op": "jsonata",
      "path": "/eventDetails",
      "expression": "eventDetails ~> | $ | {'result': result.finalScore ?? \"\"}, ['markets', 'selections'] |"
    },
    {
      "op": "jsonata",
      "path": "/now",
      "expression": "$now()"
    }
  ]
}
