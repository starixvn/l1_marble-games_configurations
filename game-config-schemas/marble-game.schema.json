{
    "title": "Marble soccer",
    "description": "Game config for the marble leagues",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean",
            "description": "Whether the game is enabled"
        },
        "teams": {
            "type": "array",
            "description": "List of team names",
            "items": {
                "type": "string"
            }
        },
        "numberOfVideos": {
            "type": "object",
            "description": "Number of videos for each result sequence",
            "additionalProperties": {
                "type": "number"
            }
        },
        "matches": {
            "type": "object",
            "properties": {
                "homeTeam": {
                    "type": "string",
                    "description": "Home team name"
                },
                "awayTeam": {
                    "type": "string",
                    "description": "Away team name"
                }
            },
            "required": ["homeTeam", "awayTeam"]
        },
        "teamSelectionMode": {
            "type": "number",
            "enum": [1, 2, 3]
        }
    },
    "required": ["enabled", "teams", "numberOfVideos", "matches"],
    "additionalProperties": false
}