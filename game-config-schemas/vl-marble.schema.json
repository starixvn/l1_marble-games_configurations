{
  "title": "Marble Soccer VL (V.League 1)",
  "type": "object",
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean",
      "default": false
    },
    "teams": {
      "title": "Teams",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "numberOfVideos": {
      "title": "Number of videos",
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "matches": {
      "title": "Matches",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
            "homeTeam": {
                "type": "string",
                "title": "Home Team"
              },
              "awayTeam": {
                "type": "string",
                "title": "Away Team"
              },
          "theme": {
            "type": "string",
            "title": "Theme",
            "oneOf": [
              {
                "const": "vi_hangday",
                "title": "Sân Hàng Đẫy"
              },
              {
                "const": "vi_thongnhat",
                "title": "Sân Thống Nhất"
              },
              {
                "const": "vi_lachtray",
                "title": "Sân Lạch Tray"
              },
              {
                "const": "vi_thientruong",
                "title": "Sân Thiên Trường"
              },
              {
                "const": "vi_vinh",
                "title": "Sân Vinh"
              }
            ]
          }
        },
        "required": ["homeTeam", "awayTeam"]
      }
    },
    "teamSelectionMode": {
      "title": "Team selection mode",
      "type": "number",
      "oneOf": [
        {
          "const": 1,
          "title": "Random Team Pairing"
        },
        {
          "const": 2,
          "title": "Manual Match Setup"
        }
      ]
    }
  },
  "required": ["enabled"]
}

